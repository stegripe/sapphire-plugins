{
    "name": "@stegripe/sapphire-plugins",
    "version": "1.0.0",
    "description": "A bunch of plugins for the Sapphire Framework that used we used in our projects",
    "license": "CC-BY-NC-ND-4.0",
    "author": "Stegripe Development <support@stegripe.org>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stegripe/sapphire-plugins.git"
    },
    "bugs": {
        "url": "https://github.com/stegripe/sapphire-plugins/issues"
    },
    "homepage": "https://docs.stegripe.org",
    "type": "module",
    "scripts": {
        "build": "turbo run build --filter=./packages/* --dangerously-disable-package-manager-check",
        "build:docs": "typedoc",
        "clean": "turbo run clean --filter=./packages/* --dangerously-disable-package-manager-check",
        "lint": "turbo run lint --filter=./packages/* --dangerously-disable-package-manager-check",
        "lint:fix": "turbo run lint:fix --filter=./packages/* --dangerously-disable-package-manager-check",
        "typecheck": "turbo run typecheck --filter=./packages/* --dangerously-disable-package-manager-check",
        "release": "pnpm build && changeset publish"
    },
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=22",
        "npm": ">=10"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.3",
        "@changesets/cli": "^3.0.3",
        "@sapphire/ts-config": "^5.0.3",
        "@stegripe/biomejs-config": "^1.1.0",
        "@types/node": "^24.19.2",
        "rimraf": "^6.1.3",
        "tsdown": "^0.23.2",
        "turbo": "^2.11.10",
        "typedoc": "^0.28.20",
        "typedoc-material-theme": "^1.4.1",
        "typedoc-plugin-djs-links": "^2.2.1",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "~6.0.3"
    }
}
